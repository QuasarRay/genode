+static BOOT_CODE void remove_reserved_p_regs(p_region_t const check)
+{
+    for (int i = 0; i < boot_state.mem_p_regs.count; i++) {
+        bool_t replaced = false;
+
+        p_region_t const region = boot_state.mem_p_regs.list[i];
+
+        if (region.end   <= check.start) continue;
+        if (region.start >= check.end)   continue;
+
+        printf("Adjusting range %lx-%lx intersecting with reserved range %lx-%lx\n",
+               region.start, region.end, check.start, check.end);
+
+        if (region.start < check.start) {
+            boot_state.mem_p_regs.list[i].end = check.start;
+            replaced = true;
+        }
+        if (check.end < region.end) {
+            if (replaced)
+                add_mem_p_regs((p_region_t){ check.end, region.end });
+            else
+                boot_state.mem_p_regs.list[i].start = check.end;
+        }
+    }
+
+    /* sort */
+    for (int i = boot_state.mem_p_regs.count - 1; i > 0; i--) {
+
+        p_region_t const region = boot_state.mem_p_regs.list[i - 0];
+        p_region_t const before = boot_state.mem_p_regs.list[i - 1];
+
+        if (region.start < before.start) {
+            boot_state.mem_p_regs.list[i - 1] = region;
+            boot_state.mem_p_regs.list[i - 0] = before;
+        }
+    }
+}
